# Secrets
#
# A pattern with no slash matches at every depth, so this one bare rule
# covers backend/.env as well as ./.env. That is what kept the Groq and
# OpenRouter keys out of history while the file briefly existed in two
# places at once.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg

# Python tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# uv and pip
#
# uv.lock and package-lock.json are deliberately NOT ignored. A lockfile
# is the record of what actually resolved, so committing it is the
# difference between a reproducible install and a hopeful one.
pip-wheel-metadata/

# Node
node_modules/
.npm
.pnpm-store/
*.tsbuildinfo
.vite/

# Build output
#
# frontend/dist is also covered by frontend/.gitignore, which Vite
# scaffolds. Repeated here so removing that file does not start
# committing bundles.
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Local scratch
#
# Anything under a scratch/ or tmp/ directory, plus the ad hoc probe
# scripts this project accumulated while measuring rate limits and
# resolution thresholds. Those belong in a scratchpad, not in history.
scratch/
tmp/
*.probe.py
probe_*.py

# Data
#
# data/raw is the corpus and data/benchmark holds the committed question
# set with its gold labels, so both stay tracked. Only derived artefacts
# are ignored.
data/processed/
data/exports/
*.dump
*.sql.gz

# Neo4j and Postgres volumes, if ever bind-mounted instead of named
neo4j_data/
neo4j_logs/
postgres_data/
